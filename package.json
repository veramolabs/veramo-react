{
  "name": "@veramo-community/veramo-react",
  "version": "1.6.8",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@veramo/core": "6.0.3-next.65",
    "@veramo/remote-client": "6.0.3-next.65",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.0",
    "@babel/preset-env": "8.0.5",
    "@babel/preset-react": "8.0.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react-hooks": "8.0.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.18",
    "@types/react-test-renderer": "19.1.0",
    "@types/uuid": "11.0.0",
    "babel-jest": "30.5.1",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.8",
    "semantic-release": "25.0.9",
    "ts-jest": "29.4.12",
    "ts-jest-resolver": "^2.0.1",
    "typescript": "7.0.2",
    "uuid": "^14.0.0"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc -b --watch",
    "format": "prettier --write \"src/**/*.*[jt]s*\"",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" jest --config=jest.cjs --coverage=false",
    "test:watch": "NODE_OPTIONS=\"--experimental-vm-modules --experimental-import-meta-resolve\" pnpm test --watch --verbose",
    "upgrade-veramo": "pnpm add -D @veramo/core@next @veramo/remote-client@next",
    "release": "semantic-release"
  },
  "prettier": {
    "jsxBracketSameLine": false,
    "trailingComma": "all",
    "tabWidth": 2,
    "printWidth": 80,
    "singleQuote": true,
    "semi": false
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "author": "Simonas Karuzas <simonas.karuzas@mesh.xyz>",
  "contributors": [
    "Jason Healy",
    "Mircea Nistor mircea.nistor@mesh.xyz"
  ]
}
